UEFI
 ├─ GOP
 │   └─ Backbuffer
 │
 ├─ Input
 │   ├─ Keyboard + Queue
 │   ├─ Simple Pointer
 │   └─ Absolute Pointer
 │
 └─ System
     ├─ TEXT VRAM 80x25
     │   ├─ ASCII Font
     │   ├─ Cursor
     │   ├─ Wrap
     │   └─ Scroll
